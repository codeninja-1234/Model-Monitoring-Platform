{
  "title": "Model Monitoring Platform",
  "uid": "model-monitoring",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Prediction requests / sec",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(model_prediction_requests_total[1m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Prediction latency (p95)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(model_prediction_latency_seconds_bucket[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latest approval probability",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "model_prediction_approval_rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Prediction errors",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(model_prediction_errors_total[1m])",
          "refId": "A"
        }
      ]
    }
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser"
}